# Plantilla de configuración del Servicio_IA (copiar a .env)
DATABASE_URL=postgresql://gds:gds@localhost:5432/gds
MODEL_CACHE=./.model_cache
DEVICE=cpu

# --- Observabilidad (Servicio_Observabilidad - D15; Req. 41.1, 41.2) ---
# Nivel del logging estructurado: DEBUG|INFO|WARNING|ERROR|CRITICAL.
LOG_LEVEL=INFO
# DSN de Sentry para captura de errores. Si se deja VACIO, la captura es no-op.
SENTRY_DSN=
# Tasa de muestreo de tracing de Sentry (0..1). Por defecto 0 (desactivado).
SENTRY_TRACES_SAMPLE_RATE=0
# Entorno reportado a Sentry.
ENVIRONMENT=development
