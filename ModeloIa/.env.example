# ============================================================
# CDPLP - IREC System Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- Application ---
APP_NAME=irec
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdplp_irec
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Reddit API (future) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CDPLP-IREC/0.1.0

# --- YouTube API (future) ---
YOUTUBE_API_KEY=

# --- Paths ---
DATA_DIR=./data
MODELS_DIR=./models
PROMPTS_DIR=./prompts
LOGS_DIR=./logs
