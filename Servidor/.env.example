# ===========================================================================
# Servidor (API REST del colegio) - Variables de entorno (ejemplo)
# Copiar a `.env` y completar con valores reales. NO commitear el `.env` real.
# ===========================================================================

# Cadena de conexion PostgreSQL (Prisma).
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd"

# Puerto del servidor HTTP.
PORT=3000

# Secreto para firmar los JWT. Usar un valor largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Credenciales Supabase (almacenamiento de archivos) --------------------
# NUNCA subir las claves reales al repositorio. Rotarlas si se filtran.
SUPABASE_URL="tu-supabase-url"
SUPABASE_SECRET_KEY="tu-supabase-secret-key"

# --- Credenciales Resend (envío de correos) --------------------------------
RESEND_API_KEY="tu-resend-api-key"
RESEND_FROM="CDPLP <noreply@tudominio.com>"
