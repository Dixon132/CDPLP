generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model actividades_institucionales {
  id_actividad                                   Int                                              @id @default(autoincrement())
  nombre                                         String?                                          @db.VarChar(150)
  descripcion                                    String?
  tipo                                           String?                                          @db.VarChar(50)
  fecha_programada                               DateTime?                                        @db.Date
  id_responsable                                 Int?
  archivo                                        String?
  costo                                          Decimal?                                         @db.Decimal(10, 2)
  estado                                         String?                                          @db.VarChar(50)
  usuarios                                       usuarios?                                        @relation(fields: [id_responsable], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  asistencias_actividad                          asistencias_actividad[]
  colegiados_registrados_actividad_institucional colegiados_registrados_actividad_institucional[]
}

model asistencias_actividad {
  id_asistencia               Int                          @id @default(autoincrement())
  id_actividad                Int?
  id_colegiado                Int?
  id_invitado                 Int?
  actividades_institucionales actividades_institucionales? @relation(fields: [id_actividad], references: [id_actividad], onDelete: NoAction, onUpdate: NoAction)
  colegiados                  colegiados?                  @relation(fields: [id_colegiado], references: [id_colegiado], onDelete: NoAction, onUpdate: NoAction)
  invitados                   invitados?                   @relation(fields: [id_invitado], references: [id_invitado], onDelete: NoAction, onUpdate: NoAction)
}

model colegiados_registrados_actividad_institucional {
  id_registro                 Int                          @id @default(autoincrement())
  id_actividad                Int?
  id_colegiado                Int?
  fecha_registro              DateTime?                    @db.Date
  estado_registro             String?                      @db.VarChar(50)
  metodo_pago                 String?                      @db.VarChar(50)
  id_invitado                 Int?
  createdAt                   DateTime?                    @default(now()) @db.Date
  updatedAt                   DateTime?                    @updatedAt @db.Date
  actividades_institucionales actividades_institucionales? @relation(fields: [id_actividad], references: [id_actividad], onDelete: NoAction, onUpdate: NoAction)
  colegiados                  colegiados?                  @relation(fields: [id_colegiado], references: [id_colegiado], onDelete: NoAction, onUpdate: NoAction)
  invitados                   invitados?                   @relation(fields: [id_invitado], references: [id_invitado], onDelete: NoAction, onUpdate: NoAction)
  origen_movimiento           origen_movimiento[]
}

model actividades_sociales {
  id_actividad_social         Int                           @id @default(autoincrement())
  nombre                      String?                       @db.VarChar(150)
  descripcion                 String?
  ubicacion                   String?                       @db.VarChar(200)
  motivo                      String?
  id_convenio                 Int?
  fecha_inicio                DateTime?                     @db.Date
  fecha_fin                   DateTime?                     @db.Date
  estado                      String?                       @db.VarChar(30)
  tipo                        String?                       @db.VarChar(50)
  latitud                     Float?
  longitud                    Float?
  radio_metros                Int?                          @default(100)
  convenio                    convenio?                     @relation(fields: [id_convenio], references: [id_convenio], onDelete: NoAction, onUpdate: NoAction)
  colegiados_asignados_social colegiados_asignados_social[]
}

model convenio {
  id_convenio          Int                    @id @default(autoincrement())
  nombre               String?                @db.VarChar(150)
  descripcion          String?
  fecha_inicio         DateTime?              @db.Date
  fecha_fin            DateTime?              @db.Date
  contacto             String?                @db.VarChar(100)
  estado               String?                @db.VarChar(30)
  actividades_sociales actividades_sociales[]
}

model correspondencia {
  id_correspondencia Int       @id @default(autoincrement())
  asunto             String?   @db.VarChar(200)
  contenido          String?
  resumen            String?
  fecha_envio        DateTime?
  fecha_recibido     DateTime?
  estado             String?   @db.VarChar(50)
  remitente          String?   @db.VarChar(100)
  id_destinatario    Int?
  createdAt          DateTime? @default(now())
  updatedAt          DateTime? @updatedAt
  destinatario       usuarios? @relation("destinatario", fields: [id_destinatario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model colegiados {
  id_colegiado                                   Int                                              @id @default(autoincrement())
  carnet_identidad                               String?                                          @unique @db.VarChar(20)
  nombre                                         String?                                          @db.VarChar(100)
  apellido                                       String?                                          @db.VarChar(100)
  correo                                         String?                                          @db.VarChar(150)
  telefono                                       String?                                          @db.VarChar(20)
  especialidades                                 String?                                          @db.VarChar(200)
  fecha_inscripcion                              DateTime?                                        @db.Date
  fecha_renovacion                               DateTime?                                        @db.Date
  estado                                         String?                                          @db.VarChar(20)
  pin_acceso                                     String?
  asistencias_actividad                          asistencias_actividad[]
  colegiados_asignados_social                    colegiados_asignados_social[]
  colegiados_registrados_actividad_institucional colegiados_registrados_actividad_institucional[]
  documentos_colegiados                          documentos_colegiados[]
  pagos_colegiados                               pagos_colegiados[]
}

model colegiados_asignados_social {
  id_asignacion            Int                        @id @default(autoincrement())
  id_actividad_social      Int?
  id_colegiado             Int?
  id_pasante               Int?
  total_horas              Float?
  horas_meta               Float?
  estado                   String?                    @default("ACTIVO") @db.VarChar(50)
  asistencia_social_diaria asistencia_social_diaria[]
  actividades_sociales     actividades_sociales?      @relation(fields: [id_actividad_social], references: [id_actividad_social], onDelete: NoAction, onUpdate: NoAction)
  colegiados               colegiados?                @relation(fields: [id_colegiado], references: [id_colegiado], onDelete: NoAction, onUpdate: NoAction)
  pasantes                 pasantes?                  @relation(fields: [id_pasante], references: [id_pasante], onDelete: NoAction, onUpdate: NoAction)
}

model asistencia_social_diaria {
  id_asistencia_diaria        Int                         @id @default(autoincrement())
  id_asignacion               Int
  fecha_marcaje               DateTime                    @db.Date
  hora_entrada                DateTime?
  hora_salida                 DateTime?
  horas_ganadas               Float?                      @default(0)
  colegiados_asignados_social colegiados_asignados_social @relation(fields: [id_asignacion], references: [id_asignacion], onDelete: Cascade)
}

model documentos_colegiados {
  id_documento      Int         @id @default(autoincrement())
  id_colegiado      Int?
  tipo_documento    String?
  archivo           String?
  fecha_entrega     DateTime?   @db.Date
  fecha_vencimiento DateTime?   @db.Date
  estado            String?     @db.VarChar(50)
  colegiados        colegiados? @relation(fields: [id_colegiado], references: [id_colegiado], onDelete: NoAction, onUpdate: NoAction)
}

model movimientos_financieros {
  id_movimiento     Int                @id @default(autoincrement())
  id_presupuesto    Int?
  fecha_movimiento  DateTime?          @default(now())
  tipo_movimiento   String?            @db.VarChar(20)
  categoria         String?            @db.VarChar(40)
  descripcion       String?
  monto             Decimal?           @db.Decimal(12, 2)
  id_origen         Int?
  comprobante       String?            @db.VarChar(300)
  id_usuario        Int?
  createdAt         DateTime?          @default(now())
  estado            String?            @default("COMPLETADO") @db.VarChar(30)
  metodo_pago       String?            @db.VarChar(50)
  tipo_origen_label String?            @default("MANUAL") @db.VarChar(50)
  // @updatedAt faltaba: era el único modelo con esta columna sin el atributo, así
  // que Prisma nunca la rellenaba y el orden "últimos modificados" no funcionaba.
  updatedAt         DateTime?          @updatedAt
  origen_movimiento origen_movimiento? @relation(fields: [id_origen], references: [id_origen], onDelete: NoAction, onUpdate: NoAction)
  presupuestos      presupuestos?      @relation(fields: [id_presupuesto], references: [id_presupuesto], onDelete: NoAction, onUpdate: NoAction)
  usuario           usuarios?          @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model origen_movimiento {
  id_origen                                      Int                                             @id @default(autoincrement())
  tipo_origen                                    String?                                         @db.VarChar(50)
  id_pago_colegiado                              Int?
  id_registro_actividad_institucional            Int?
  monto                                          Decimal?                                        @db.Decimal(12, 2)
  id_postulacion                                 Int?
  id_pago_invitado                               Int?
  movimientos_financieros                        movimientos_financieros[]
  pagos_colegiados                               pagos_colegiados?                               @relation(fields: [id_pago_colegiado], references: [id_pago], onDelete: NoAction, onUpdate: NoAction)
  pagos_invitados                                pagos_invitados?                                @relation(fields: [id_pago_invitado], references: [id_pago], onDelete: NoAction, onUpdate: NoAction)
  postulaciones                                  postulaciones?                                  @relation(fields: [id_postulacion], references: [id_postulacion], onDelete: NoAction, onUpdate: NoAction)
  colegiados_registrados_actividad_institucional colegiados_registrados_actividad_institucional? @relation(fields: [id_registro_actividad_institucional], references: [id_registro], onDelete: NoAction, onUpdate: NoAction)
}

model pagos_colegiados {
  id_pago           Int                 @id @default(autoincrement())
  id_colegiado      Int?
  concepto          String?             @db.VarChar(100)
  fecha_pago        DateTime?           @db.Date
  monto             Decimal?            @db.Decimal(10, 2)
  estado_pago       String?             @default("REALIZADO") @db.VarChar(50)
  comprobante       String?             @db.VarChar(300)
  metodo_pago       String?             @db.VarChar(50)
  origen_movimiento origen_movimiento[]
  colegiados        colegiados?         @relation(fields: [id_colegiado], references: [id_colegiado], onDelete: NoAction, onUpdate: NoAction)
}

model presupuestos {
  id_presupuesto          Int                       @id @default(autoincrement())
  nombre_presupuesto      String?                   @db.VarChar(150)
  descripcion             String?
  monto_total             Decimal?                  @db.Decimal(12, 2)
  fecha_asignacion        DateTime?                 @db.Date
  saldo_restante          Decimal?                  @db.Decimal(12, 2)
  estado                  String?                   @db.VarChar(50)
  movimientos_financieros movimientos_financieros[]
}

model auditoria {
  id_auditoria Int      @id @default(autoincrement())
  id_usuario   Int
  accion       String
  modulo       String
  descripcion  String
  fecha        DateTime @default(now())
  usuario      usuarios @relation(fields: [id_usuario], references: [id_usuario])
}

/// Aviso generado por un hecho del sistema (un pago, una inscripción, una
/// postulación...). La notificación NO se duplica por usuario: se emite una vez
/// y se muestra a todo el que tenga acceso al módulo. Quién la ha leído se
/// guarda aparte, en `notificaciones_leidas`.
model notificaciones {
  id_notificacion Int                      @id @default(autoincrement())
  modulo          String                   @db.VarChar(60)
  tipo            String                   @default("info") @db.VarChar(30)
  titulo          String                   @db.VarChar(160)
  descripcion     String?
  /// Ruta del dashboard a la que lleva al pulsarla.
  enlace          String?                  @db.VarChar(200)
  /// Autor del hecho, para no notificárselo a quien lo provocó.
  id_usuario      Int?
  createdAt       DateTime                 @default(now())
  usuario         usuarios?                @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull, onUpdate: NoAction)
  lecturas        notificaciones_leidas[]

  @@index([createdAt])
  @@index([modulo])
}

/// Marca de lectura POR usuario. Que un usuario abra una notificación no la
/// marca como leída para los demás.
model notificaciones_leidas {
  id_notificacion Int
  id_usuario      Int
  leida_en        DateTime       @default(now())
  notificacion    notificaciones @relation(fields: [id_notificacion], references: [id_notificacion], onDelete: Cascade)
  usuario         usuarios       @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_notificacion, id_usuario])
  @@index([id_usuario])
}

model pasantes {
  id_pasante                  Int                           @id @default(autoincrement())
  nombre                      String?
  apellido                    String?
  carnet_identidad            String?                       @unique @db.VarChar(20)
  correo                      String?
  telefono                    String?
  institucion                 String?
  createdAt                   DateTime?                     @default(now()) @db.Date
  updatedAt                   DateTime?                     @updatedAt @db.Date
  estado                      String?                       @db.VarChar(50)
  pin_acceso                  String?
  colegiados_asignados_social colegiados_asignados_social[]
}

model roles {
  id_rol       Int         @id @default(autoincrement())
  id_usuario   Int?
  fecha_inicio DateTime?   @db.Date
  fecha_fin    DateTime?   @db.Date
  activo       Boolean?    @default(true)
  rol          RolUsuario?
  usuarios     usuarios?   @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model usuarios {
  id_usuario                  Int                           @id @default(autoincrement())
  nombre                      String?                       @db.VarChar(100)
  apellido                    String?                       @db.VarChar(100)
  correo                      String?                       @db.VarChar(150)
  contrase_a                  String?                       @map("contraseña") @db.VarChar(300)
  telefono                    String?                       @db.VarChar(20)
  direccion                   String?                       @db.VarChar(200)
  fecha_registro              DateTime?                     @default(now()) @db.Date
  estado                      String?                       @default("ACTIVO") @db.VarChar(20)
  fecha_actualizacion         DateTime?                     @updatedAt @db.Date
  actividades_institucionales actividades_institucionales[]
  auditoria                   auditoria[]
  destinatario                correspondencia[]             @relation("destinatario")
  movimientos_financieros     movimientos_financieros[]
  roles                       roles[]
  notificaciones              notificaciones[]
  notificaciones_leidas       notificaciones_leidas[]
}

model invitados {
  id_invitado                                    Int                                              @id @default(autoincrement())
  nombre                                         String
  apellido                                       String
  correo                                         String?
  telefono                                       String?
  estado                                         String?                                          @default("ACTIVO") @db.VarChar(50)
  asistencias_actividad                          asistencias_actividad[]
  colegiados_registrados_actividad_institucional colegiados_registrados_actividad_institucional[]
  pagos_invitados                                pagos_invitados[]
}

model postulaciones {
  id_postulacion    Int                 @id @default(autoincrement())
  carnet_identidad  String              @db.VarChar(20)
  nombre            String              @db.VarChar(100)
  apellido          String              @db.VarChar(100)
  correo            String              @db.VarChar(150)
  telefono          String              @db.VarChar(20)
  especialidades    String?             @db.VarChar(500)
  documentos        String?
  comprobante_pago  String?             @db.VarChar(300)
  estado            String              @default("EN_REVISION") @db.VarChar(30)
  motivo_rechazo    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  metodo_pago       String?             @db.VarChar(50)
  origen_movimiento origen_movimiento[]
}

model especialidades {
  id_especialidad Int      @id @default(autoincrement())
  nombre          String   @unique @db.VarChar(150)
  descripcion     String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model documentos_requeridos {
  id_doc_req  Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(200)
  descripcion String?
  activo      Boolean  @default(true)
  es_opcional Boolean  @default(false)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
}

model config_pago {
  id          Int      @id @default(autoincrement())
  clave       String   @unique @db.VarChar(50)
  valor       String
  descripcion String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt
}

model memorias_balances {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(200)
  descripcion String?
  archivo     String   @db.VarChar(500)
  categoria   String   @db.VarChar(100)
  anio        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model pagos_invitados {
  id_pago           Int                 @id @default(autoincrement())
  id_invitado       Int?
  concepto          String?             @db.VarChar(100)
  fecha_pago        DateTime?           @db.Date
  monto             Decimal?            @db.Decimal(10, 2)
  estado_pago       String?             @default("REALIZADO") @db.VarChar(50)
  comprobante       String?             @db.VarChar(300)
  metodo_pago       String?             @db.VarChar(50)
  origen_movimiento origen_movimiento[]
  invitados         invitados?          @relation(fields: [id_invitado], references: [id_invitado], onDelete: NoAction, onUpdate: NoAction)
}

enum RolUsuario {
  SECRETARIO_GENERAL
  PRESIDENTE
  VICEPRESIDENTE
  VOCAL
  SECRETARIO
  TESORERO
  NO_DEFINIDO
}

model instituciones {
    id_institucion Int      @id @default(autoincrement())
    nombre         String   @unique @db.VarChar(150)
}
