# ===========================================================================
# Variables de entorno para docker-compose (Plataforma_GDS).
# Copiar a `.env` en la raiz del repo y ajustar antes de `docker compose up`.
# Los valores aqui mostrados coinciden con los defaults del docker-compose.yml.
# ===========================================================================

# --- PostgreSQL + pgvector (BD dedicada del ServidorGDS) -------------------
POSTGRES_USER=gds
POSTGRES_PASSWORD=gds
POSTGRES_DB=gds_db

# --- Secreto JWT compartido con el colegio (ServidorGDS valida los tokens) --
JWT_SECRET=cambia-esto-por-el-secreto-compartido

# --- Puertos publicados en el host ----------------------------------------
# Frontend (Nginx) y API del ServidorGDS. El Servicio_IA NO se publica.
FRONTEND_PORT=8080
GDS_API_PORT=4100

# --- Origen del frontend (CORS del ServidorGDS) ----------------------------
CORS_ORIGIN=http://localhost:8080

# --- Origen del backend visible para el navegador (build del frontend) -----
# Por defecto mismo-origen del Nginx del frontend (reverse proxy /api/gds).
VITE_GDS_API_URL=http://localhost:8080

# --- Dispositivo de inferencia del Servicio_IA (cpu | cuda) ----------------
SERVICIO_IA_DEVICE=cpu
