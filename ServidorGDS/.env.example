# ===========================================================================
# ServidorGDS - Variables de entorno (ejemplo)
# Copiar a `.env` y completar con valores reales. NO commitear el `.env` real.
# ===========================================================================

# Puerto propio del servicio autonomo (independiente del Servidor del colegio - Req. 25.8)
PORT=4100

# Base de datos PostgreSQL + pgvector DEDICADA e INDEPENDIENTE de la Plataforma_GDS.
# NUNCA debe apuntar a la base de datos del colegio (aislamiento total - Req. 25.1, 25.3).
DATABASE_URL="postgresql://usuario:password@localhost:5432/gds_db?schema=public"

# Instancia de Redis PROPIA del servicio, usada por BullMQ y la cache (Req. 38.1).
REDIS_URL="redis://localhost:6379"

# Secreto JWT COMPARTIDO con el colegio para validar los tokens emitidos por este.
# Los roles GDS se resuelven contra la propia base de datos del servicio (Req. 24, 25.3).
JWT_SECRET="cambia-esto-por-el-secreto-compartido"

# URL base del Servicio_IA (Python/FastAPI) consumido por HTTP. No se expone
# publicamente; vive en red interna/contenedores (Req. 35).
SERVICIO_IA_URL="http://localhost:8000"

# Origen permitido del Frontend_GDS (CORS)
CORS_ORIGIN="http://localhost:5173"

# Entorno de ejecucion
NODE_ENV=development

# ---------------------------------------------------------------------------
# Observabilidad (Servicio_Observabilidad - D15; Req. 41.1, 41.2)
# ---------------------------------------------------------------------------
# Nivel del logger estructurado Pino: trace|debug|info|warn|error|fatal|silent.
# Por defecto `info` (y `silent` en entorno de pruebas).
LOG_LEVEL=info

# DSN de Sentry para captura de errores no controlados. Si se deja VACIO, la
# captura de errores queda como no-op (dev/test/CI no requieren Sentry).
SENTRY_DSN=

# Tasa de muestreo de tracing de Sentry (0..1). Por defecto 0 (desactivado).
SENTRY_TRACES_SAMPLE_RATE=0
