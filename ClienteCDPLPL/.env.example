# Servidor del colegio (proxy /api en desarrollo).
VITE_API_URL = http://localhost:3000

# URL base del backend autónomo de la Plataforma_GDS (ServidorGDS/).
# Es un servicio independiente que corre en su PROPIO puerto y expone su API
# bajo /api/gds. No usar el puerto del servidor del colegio.
VITE_GDS_API_URL = http://localhost:4000

# (Opcional) Origen del WS Hub de progreso en vivo (socket.io, namespace
# gds/progreso). Si se omite, el cliente WS deriva el origen de VITE_GDS_API_URL.
# VITE_GDS_WS_URL = http://localhost:4000
